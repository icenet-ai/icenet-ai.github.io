---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Team from '~/components/widgets/Team.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import Stats from '~/components/widgets/Stats.astro';
import VerticalTimeline from '~/components/widgets/VerticalTimeline.astro';

const metadata = {
  title: 'IceNet — AI powered sea-ice forecasting',
  ignoreTitleTemplate: true,
};

import { METADATA } from 'astrowind:config';
import { fetchPyPIDownloadStats, fetchGitHubStats } from '../utils/custom-utils';

const github_org = METADATA.github.org;
const github_repo = METADATA.github.repo;

const download_stats = await fetchPyPIDownloadStats(METADATA.package.name.toLowerCase());
const n_downloads_last_month = download_stats.data.last_month;
const github_stats = await fetchGitHubStats(github_org, github_repo);

import type { ImageMetadata } from 'astro';

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/**/*.{jpeg,jpg,png,gif}');
---

<!-- image={{ src: '~/assets/images/hero-image.png', alt: 'Hero Image' }} -->
<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    id="hero"
    actions={[
      {
        variant: 'primary',
        text: 'Get started (Basic)',
        href: 'https://edsbook.org/67a1e320-7c47-4ea9-8df8-e868326bc90b/notebook',
        target: '_blank',
        icon: 'tabler:external-link-off',
      },
      {
        variant: 'primary',
        text: 'Get started (Advanced)',
        href: '#repositories',
      },
      { text: 'About', href: '#about-us' },
    ]}
    image="/images/hero-image.png"
    backgroundColor="dark:bg-sky-950"
  >
    <Fragment slot="title">
      <p>IceNet</p>
      <p>Machine Learning for Seasonal Sea Ice Forecasting</p>
    </Fragment>
    Researchers at the British Antarctic Survey and the Alan Turing Institute are using the Dawn supercomputer to forecast
    daily sea ice concentration maps. This step-change in sea ice forecasting ability brings us closer to conservation tools
    that mitigate risks associated with rapid sea ice loss.
  </Hero>

  <!-- Note Widget ******************* -->

  <Note />

  <!-- About IceNet Widget ***************  -->
  <Hero
    id="about-us"
    tagline="About us"
    actions={[
      {
        variant: 'primary',
        text: 'PolarSim at British Antarctic Survey',
        href: 'https://www.bas.ac.uk/polar-operations/sites-and-facilities/facility/polarsim-ai-forecasting-and-modelling/',
        target: '_blank',
        icon: 'tabler:external-link',
      },
      {
        variant: 'primary',
        text: 'CryoCast at Alan Turing Institute',
        href: 'https://www.turing.ac.uk/research/research-projects/cryocast-ai-sea-ice-predictions-and-polar-resilience',
        target: '_blank',
        icon: 'tabler:external-link',
      },
    ]}
  >
    <Fragment slot="title">
      About IceNet <br />
    </Fragment>

    <Fragment slot="subtitle">
      <div class="intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
        <p>
          IceNet is a deep learning sea ice forecasting system developed by the
          <a
            class="hyperlink"
            href="https://www.bas.ac.uk/media-post/artificial-intelligence-to-help-predict-arctic-sea-ice-loss/"
          >
            British Antarctic Survey and The Alan Turing Institute
          </a>.
          The original IceNet research model, published in
          <a
            class="hyperlink"
            href="https://www.nature.com/articles/s41467-021-25257-4"
          >
            <b>Nature Communications</b>
          </a>,
          was trained on climate simulations and observational data to forecast the next 6 months of
          monthly-averaged sea ice concentration maps. This version advanced the range of accurate sea
          ice forecasts, outperforming a state-of-the-art dynamical model (ECMWF SEAS5) in seasonal
          forecasts of summer sea ice, particularly for extreme sea ice events. <br><br>
        </p>

        <p>
          IceNet began in 2019 as a joint initiative between the British Antarctic Survey and the Alan
          Turing Institute. It was one of the earliest environmental forecasting models to demonstrate
          that deep learning could outperform traditional physics-based models, in this case producing
          daily and monthly sea-ice forecasts up to six months in advance. While active development on
          IceNet ended in 2025, all original research outputs, publications, and core open-source
          repositories remain fully accessible to the global scientific community. <br><br>
        </p>

        <p>
          The teams are now focused on building next-generation, sustainable forecasting models and
          pipelines through PolarSim at the British Antarctic Survey and CryoCast at The Alan Turing
          Institute. <br><br>
        </p>

      </div>
    </Fragment>

  </Hero>

  <!-- HighlightedPosts Widget ******* -->

